{
  "name": "slidev-course-boilerplate",
  "type": "module",
  "author": {
    "name": "zeriix",
    "url": "https://github.com/ZeRiix"
  },
  "private": true,
  "scripts": {
    "build": "slidev build",
    "build:local": "slidev build --base ./",
    "dev": "slidev --open",
