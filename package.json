    "test:lint:fix": "eslint --quiet --fix",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@duplojs/utils": "1.10.3",
    "@slidev/cli": "52.19.1",
    "slidev-theme-neversink": "0.4.1",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@duplojs/eslint": "0.5.0",
    "@slidev/types": "52.19.1",
    "@types/web": "0.0.356",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "husky": "9.1.7",
    "patch-package": "8.0.1",
    "playwright-chromium": "1.63.0",
    "sass-embedded": "1.104.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
